# Copie para .env.local (nunca commite o arquivo com valores reais)

# Supabase (públicas: seguras para o navegador, protegidas pela RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor e Edge Functions. NUNCA no front.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business Platform (Meta). Somente servidor.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=

# Sentry
SENTRY_DSN=
