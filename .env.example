# Copie para .env.local (nunca commite o arquivo com valores reais)
# Local: os valores saem de `npx supabase status`.

# Endereço público do app (usado nos links dos e-mails de confirmação). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Supabase (públicas: seguras para o navegador, protegidas pela RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor e Edge Functions. NUNCA no front. (substitui a antiga service_role key)
SUPABASE_SECRET_KEY=

# CAPTCHA da página pública (Cloudflare Turnstile). Local e Preview: chaves de teste da Cloudflare
# (sempre passam): site 1x00000000000000000000AA, segredo 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp Business Platform (Meta). Somente servidor.
# META_APP_SECRET: segredo do app (Configurações do app > Básico); valida a assinatura do webhook.
# META_WEBHOOK_VERIFY_TOKEN: texto qualquer, o mesmo digitado ao cadastrar o webhook na Meta.
# META_ACCESS_TOKEN: token de acesso (para a análise do app, o temporário ou o de usuário do sistema).
# META_PHONE_NUMBER_ID: ID do número que envia (Configuração da API > "Identificação do número de telefone").
# META_GRAPH_VERSION: opcional (padrão v23.0).
# URL do webhook na Meta: https://<domínio>/api/whatsapp/webhook, campo "messages" assinado.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=

# Sentry
SENTRY_DSN=
